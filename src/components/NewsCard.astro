---
const { item } = Astro.props;
---
<article class="news-card"><a class="news-image-link" href={`/news/${item.slug}`} tabindex="-1" aria-hidden="true"><img src={item.image} alt="" loading="lazy" /></a><div class="news-card-copy"><div class="news-source">{item.source}<span>·</span>{item.published.split(' · ')[0]}</div><h3><a href={`/news/${item.slug}`}>{item.headline}</a></h3><p>{item.summary}</p><a class="text-link" href={`/news/${item.slug}`}>Read story <span aria-hidden="true">↗</span></a></div></article>
